---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');
const tagCounts = posts.reduce((acc, post) => {
	(post.data.tags || []).forEach((t) => {
		const tag = t.trim();
		if (tag) {
			acc[tag] = (acc[tag] || 0) + 1;
		}
	});
	return acc;
}, {} as Record<string, number>);

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={`Chủ đề / Tags | ${SITE_TITLE}`} description="Tổng hợp tất cả chủ đề trên blog Góc Mặc Đẹp." />
		<style>
			.tags-wrapper {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				margin-top: 2em;
			}
			.tag-item {
				display: inline-flex;
				align-items: center;
				background: #f1f5f9;
				padding: 8px 16px;
				border-radius: 9999px;
				color: rgb(var(--gray-dark));
				text-decoration: none;
				font-size: 16px;
				transition: all 0.2s;
			}
			.tag-item:hover {
				background: var(--accent);
				color: #fff;
			}
			.tag-count {
				margin-left: 8px;
				background: rgba(0, 0, 0, 0.08);
				padding: 2px 8px;
				border-radius: 9999px;
				font-size: 13px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Khám phá theo chủ đề</h1>
			<p>Tìm kiếm bài viết theo từ khóa quan tâm:</p>
			<div class="tags-wrapper">
				{
					sortedTags.map(([tag, count]) => (
						<a href={`/tags/${encodeURIComponent(tag.toLowerCase())}`} class="tag-item">
							#{tag} <span class="tag-count">{count}</span>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

