---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = posts.slice(0, 6);

// Lấy tất cả các tags
const allTags = [...new Set(posts.flatMap((post) => post.data.tags || []))];
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero-banner {
				text-align: center;
				padding: 3.5em 1em 2.5em 1em;
				background: linear-gradient(180deg, var(--accent-light) 0%, rgba(255,255,255,0) 100%);
				border-radius: 16px;
				margin-bottom: 3em;
			}
			.hero-banner h1 {
				font-size: 2.8em;
				color: var(--accent);
				margin-bottom: 0.3em;
			}
			.hero-banner p {
				font-size: 1.25em;
				color: rgb(var(--gray-dark));
				max-width: 600px;
				margin: 0 auto;
			}
			.section-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 1.5em;
			}
			.post-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
				gap: 2em;
				list-style-type: none;
				margin: 0 0 3em 0;
				padding: 0;
			}
			.post-card {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 12px;
				overflow: hidden;
				transition: transform 0.2s, box-shadow 0.2s;
				display: flex;
				flex-direction: column;
			}
			.post-card:hover {
				transform: translateY(-4px);
				box-shadow: var(--box-shadow);
			}
			.post-card img {
				width: 100%;
				height: 200px;
				object-fit: cover;
			}
			.post-content {
				padding: 1.2em;
				display: flex;
				flex-direction: column;
				flex-grow: 1;
			}
			.post-title {
				font-size: 1.3em;
				font-weight: 700;
				margin: 0 0 0.5em 0;
				line-height: 1.3;
			}
			.post-title a {
				color: rgb(var(--black));
				text-decoration: none;
			}
			.post-title a:hover {
				color: var(--accent);
			}
			.post-desc {
				font-size: 15px;
				color: rgb(var(--gray));
				line-height: 1.6;
				margin-bottom: 1em;
				flex-grow: 1;
			}
			.post-meta {
				font-size: 14px;
				color: rgb(var(--gray));
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding-top: 0.8em;
				border-top: 1px solid #f1f5f9;
			}
			.tag-cloud {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				margin-bottom: 3em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero-banner">
				<h1>{SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
			</section>

			<section>
				<div class="section-header">
					<h2>Bài viết mới nhất</h2>
					<a href="/blog">Xem tất cả &rarr;</a>
				</div>
				<ul class="post-grid">
					{
						recentPosts.map((post) => (
							<li class="post-card">
								{post.data.heroImage && (
									<a href={`/blog/${post.id}/`}>
										<img src={post.data.heroImage} alt={post.data.title} />
									</a>
								)}
								<div class="post-content">
									<h3 class="post-title">
										<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									</h3>
									<p class="post-desc">{post.data.description}</p>
									<div class="post-meta">
										<span><FormattedDate date={post.data.pubDate} /></span>
										{post.data.category && (
											<span class="badge">{post.data.category}</span>
										)}
									</div>
								</div>
							</li>
						))
					}
				</ul>
			</section>

			{allTags.length > 0 && (
				<section>
					<h2>Chủ đề được quan tâm</h2>
					<div class="tag-cloud">
						{allTags.map((tag) => (
							<a href={`/tags/${encodeURIComponent(tag.toLowerCase())}`} class="badge">
								#{tag}
							</a>
						))}
					</div>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>
