---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Lấy danh sách chuyên mục
const categories = [...new Set(posts.map((p) => p.data.category).filter(Boolean))];
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={`Tất cả bài viết | ${SITE_TITLE}`} description="Tổng hợp các bài viết về phong cách thời trang, cách phối đồ và bí quyết làm đẹp." />
		<style>
			.page-header {
				margin-bottom: 3.5em;
				text-align: center;
				padding: 2em 1em 1em 1em;
			}
			.page-header h1 {
				font-size: 3em;
				color: var(--text-dark);
				margin-bottom: 0.3em;
				letter-spacing: -0.01em;
			}
			.page-header p {
				font-size: 19px;
				color: var(--text-muted);
				max-width: 600px;
				margin: 0 auto;
			}

			/* Category Filter Bar */
			.filter-bar {
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 10px;
				margin-bottom: 3em;
			}

			.post-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
				gap: 2.5em;
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-card {
				background: #ffffff;
				border-radius: var(--radius-md);
				overflow: hidden;
				box-shadow: var(--shadow-card);
				border: 1px solid var(--border-card);
				display: flex;
				flex-direction: column;
				transition: var(--transition);
			}
			.post-card:hover {
				transform: translateY(-6px);
				box-shadow: var(--shadow-hover);
			}
			.post-thumb {
				position: relative;
				height: 240px;
				overflow: hidden;
			}
			.post-thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				transition: transform 0.6s ease;
			}
			.post-card:hover .post-thumb img {
				transform: scale(1.08);
			}
			.post-cat {
				position: absolute;
				top: 14px;
				left: 14px;
				background: rgba(255, 255, 255, 0.95);
				backdrop-filter: blur(6px);
				color: var(--primary);
				padding: 4px 12px;
				border-radius: var(--radius-pill);
				font-size: 11px;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
			}
			.post-body {
				padding: 1.8em;
				display: flex;
				flex-direction: column;
				flex-grow: 1;
			}
			.post-body h2 {
				font-size: 1.45em;
				line-height: 1.35;
				margin: 0 0 0.6em 0;
			}
			.post-body h2 a {
				color: var(--text-dark);
				text-decoration: none;
			}
			.post-body h2 a:hover {
				color: var(--primary);
			}
			.post-desc {
				font-size: 15px;
				color: var(--text-muted);
				line-height: 1.65;
				margin-bottom: 1.4em;
				flex-grow: 1;
			}
			.post-meta {
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 13px;
				color: var(--text-light);
				padding-top: 1em;
				border-top: 1px solid #f8fafc;
			}
			@media (max-width: 640px) {
				.post-grid {
					grid-template-columns: 1fr;
				}
				.page-header h1 {
					font-size: 2.3em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Tất cả bài viết</h1>
				<p>Khám phá phong cách thời trang và những mẹo làm đẹp mới nhất</p>
			</div>

			{categories.length > 0 && (
				<div class="filter-bar">
					<span class="badge" style="background: var(--primary); color: #fff; border-color: transparent;">Tất cả</span>
					{categories.map((cat) => (
						<span class="badge" style="cursor: pointer;">{cat}</span>
					))}
				</div>
			)}

			<ul class="post-grid">
				{
					posts.map((post) => (
						<li class="post-card">
							<div class="post-thumb">
								{post.data.category && (
									<span class="post-cat">{post.data.category}</span>
								)}
								{post.data.heroImage && (
									<a href={`/blog/${post.id}/`}>
										<img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
									</a>
								)}
							</div>
							<div class="post-body">
								<h2>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h2>
								<p class="post-desc">{post.data.description}</p>
								<div class="post-meta">
									<span><FormattedDate date={post.data.pubDate} /></span>
									<a href={`/blog/${post.id}/`} style="font-weight: 700;">Đọc tiếp &rarr;</a>
								</div>
							</div>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
