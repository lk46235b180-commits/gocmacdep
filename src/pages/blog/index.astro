---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={`Tất cả bài viết | ${SITE_TITLE}`} description="Tổng hợp các bài viết về phong cách thời trang, cách phối đồ và bí quyết làm đẹp." />
		<style>
			.page-header {
				margin-bottom: 2.5em;
				text-align: center;
			}
			.page-header h1 {
				font-size: 2.4em;
				color: rgb(var(--black));
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-item {
				display: flex;
				gap: 1.5em;
				margin-bottom: 2em;
				padding-bottom: 2em;
				border-bottom: 1px solid #e2e8f0;
				align-items: center;
			}
			.post-item:last-child {
				border-bottom: none;
			}
			.post-thumb {
				width: 240px;
				height: 150px;
				flex-shrink: 0;
				border-radius: 8px;
				overflow: hidden;
			}
			.post-thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.3s;
			}
			.post-thumb:hover img {
				transform: scale(1.05);
			}
			.post-details {
				flex-grow: 1;
			}
			.post-item h2 {
				font-size: 1.4em;
				margin: 0 0 0.4em 0;
			}
			.post-item h2 a {
				color: rgb(var(--black));
				text-decoration: none;
			}
			.post-item h2 a:hover {
				color: var(--accent);
			}
			.post-desc {
				font-size: 16px;
				color: rgb(var(--gray));
				margin-bottom: 0.8em;
				line-height: 1.6;
			}
			.post-meta {
				font-size: 14px;
				color: rgb(var(--gray));
				display: flex;
				gap: 1em;
				align-items: center;
			}
			@media (max-width: 640px) {
				.post-item {
					flex-direction: column;
					align-items: flex-start;
				}
				.post-thumb {
					width: 100%;
					height: 180px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Tất cả bài viết</h1>
				<p>Khám phá phong cách thời trang và những mẹo làm đẹp mới nhất</p>
			</div>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li class="post-item">
							{post.data.heroImage && (
								<a href={`/blog/${post.id}/`} class="post-thumb">
									<img src={post.data.heroImage} alt={post.data.title} />
								</a>
							)}
							<div class="post-details">
								<h2>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h2>
								<p class="post-desc">{post.data.description}</p>
								<div class="post-meta">
									<span><FormattedDate date={post.data.pubDate} /></span>
									{post.data.category && (
										<span class="badge">{post.data.category}</span>
									)}
								</div>
							</div>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
