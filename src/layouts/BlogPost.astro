---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
	tags?: string[];
	category?: string;
}

const { title, description, pubDate, updatedDate, heroImage, tags = [], category } = Astro.props;
---

<html lang="vi">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			/* Luxury Reading Progress Line */
			#reading-bar {
				position: fixed;
				top: 0;
				left: 0;
				height: 3.5px;
				background: var(--primary-gradient);
				width: 0%;
				z-index: 99999;
				box-shadow: 0 0 10px rgba(225, 29, 72, 0.5);
				transition: width 0.1s ease-out;
			}

			.post-wrapper {
				max-width: 840px;
				margin: 0 auto;
			}

			.post-header {
				text-align: center;
				padding: 1.5em 0 3em 0;
			}

			.post-category-badge {
				display: inline-block;
				background: var(--primary-light);
				color: var(--primary);
				border: 1px solid var(--primary-soft);
				padding: 5px 16px;
				border-radius: var(--radius-pill);
				font-size: 12px;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				margin-bottom: 1.2em;
			}

			.post-main-title {
				font-size: 3.2em;
				line-height: 1.2;
				color: var(--text-dark);
				margin: 0 0 0.5em 0;
				letter-spacing: -0.015em;
			}

			.post-lead-desc {
				font-size: 20px;
				line-height: 1.7;
				color: var(--text-muted);
				max-width: 720px;
				margin: 0 auto 1.8em auto;
				font-style: italic;
			}

			.post-meta-strip {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 1.5em;
				font-size: 14px;
				color: var(--text-light);
				flex-wrap: wrap;
				padding-top: 1.2em;
				border-top: 1px solid var(--border-light);
			}

			.hero-banner-frame {
				width: 100%;
				margin: 2em 0 4em 0;
				border-radius: var(--radius-lg);
				overflow: hidden;
				box-shadow: var(--shadow-card);
				border: 1px solid var(--border-light);
			}

			.hero-banner-frame img {
				width: 100%;
				max-height: 560px;
				object-fit: cover;
				display: block;
			}

			/* Nội dung bài viết phong cách Tạp chí */
			.article-body {
				font-size: 19px;
				line-height: 1.95;
				color: #1e293b;
			}

			.article-body :global(h2) {
				font-size: 2.1em;
				margin-top: 2.2em;
				margin-bottom: 0.6em;
				color: var(--text-dark);
				position: relative;
				padding-bottom: 0.4em;
			}

			.article-body :global(h2::after) {
				content: '';
				position: absolute;
				bottom: 0;
				left: 0;
				width: 60px;
				height: 3px;
				background: var(--primary-gradient);
				border-radius: 99px;
			}

			.article-body :global(h3) {
				font-size: 1.55em;
				margin-top: 1.6em;
				margin-bottom: 0.5em;
				color: var(--text-dark);
			}

			.article-body :global(p) {
				margin-bottom: 1.8em;
			}

			.article-body :global(img) {
				border-radius: var(--radius-md);
				margin: 2.5em 0;
				box-shadow: var(--shadow-card);
			}

			/* Editorial Signature Card */
			.editorial-author-card {
				margin: 5em 0 3em 0;
				padding: 3em;
				background: #ffffff;
				border-radius: var(--radius-lg);
				border: 1px solid var(--border-light);
				box-shadow: var(--shadow-card);
				display: flex;
				align-items: center;
				gap: 2em;
			}

			.editorial-crest {
				width: 80px;
				height: 80px;
				border-radius: 20px;
				background: var(--primary-gradient);
				color: #ffffff;
				display: flex;
				align-items: center;
				justify-content: center;
				font-family: var(--font-display);
				font-size: 2.2em;
				font-weight: 700;
				flex-shrink: 0;
				box-shadow: 0 10px 20px rgba(190, 18, 60, 0.25);
			}

			.editorial-author-info h4 {
				font-size: 1.4em;
				margin: 0 0 0.4em 0;
				color: var(--text-dark);
			}

			.editorial-author-info p {
				margin: 0;
				font-size: 16px;
				color: var(--text-muted);
				line-height: 1.7;
			}

			.back-center {
				text-align: center;
				margin: 3em 0;
			}

			@media (max-width: 768px) {
				.post-main-title {
					font-size: 2.2em;
				}
				.post-lead-desc {
					font-size: 18px;
				}
				.article-body {
					font-size: 18px;
				}
				.editorial-author-card {
					flex-direction: column;
					text-align: center;
					padding: 2em 1.5em;
				}
			}
		</style>
	</head>

	<body>
		<div id="reading-bar"></div>

		<Header />
		<main>
			<article class="post-wrapper">
				<header class="post-header">
					{category && <span class="post-category-badge">{category}</span>}
					<h1 class="post-main-title">{title}</h1>
					{description && <p class="post-lead-desc">{description}</p>}
					
					<div class="post-meta-strip">
						<span>Ngày đăng: <FormattedDate date={pubDate} /></span>
						{updatedDate && <span>• Cập nhật: <FormattedDate date={updatedDate} /></span>}
					</div>

					{tags.length > 0 && (
						<div style="display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin-top: 1.5em;">
							{tags.map((tag) => (
								<a href={`/tags/${encodeURIComponent(tag.toLowerCase())}`} class="badge">
									#{tag}
								</a>
							))}
						</div>
					)}
				</header>

				{heroImage && (
					<div class="hero-banner-frame">
						<img src={heroImage} alt={title} />
					</div>
				)}

				<div class="article-body">
					<slot />
				</div>

				<!-- Khối Tác Giả & Tôn vinh thương hiệu -->
				<div class="editorial-author-card">
					<div class="editorial-crest">G</div>
					<div class="editorial-author-info">
						<h4>Ban Biên Tập Góc Mặc Đẹp</h4>
						<p>Chia sẻ kiến thức chuyên sâu về nghệ thuật phối đồ, xu hướng thời trang ứng dụng và nuôi dưỡng phong thái tự tin cho phái đẹp mỗi ngày.</p>
					</div>
				</div>

				<div class="back-center">
					<a href="/blog" class="btn-primary">&larr; Quay lại danh sách ấn phẩm</a>
				</div>
			</article>
		</main>
		<Footer />

		<script>
			window.addEventListener('scroll', () => {
				const total = document.documentElement.scrollHeight - window.innerHeight;
				const progress = total > 0 ? (window.scrollY / total) * 100 : 0;
				const bar = document.getElementById('reading-bar');
				if (bar) bar.style.width = Math.min(100, Math.max(0, progress)) + '%';
			});
		</script>
	</body>
</html>
